<style>
:root{--ink:#29251f;--muted:#766e63;--cream:#f7f3ed;--sand:#e8ded0;--line:#e8e1d8;--white:#fff;--accent:#9a7654;--gold:#b18a42}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--ink);font-family:Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}.announcement{background:var(--ink);color:#fff;text-align:center;padding:10px;font-size:11px;letter-spacing:.13em}.header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid var(--line)}.nav{max-width:1200px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:17px 22px;gap:16px}.brand{font:30px Georgia,serif;letter-spacing:.04em}.links{display:flex;gap:22px;font-size:12px;color:var(--muted)}.nav-actions{display:flex;gap:10px}.outline,.dark,.text-btn{border:1px solid var(--ink);background:transparent;color:var(--ink);padding:11px 15px;font-size:11px;letter-spacing:.08em}.dark{background:var(--ink);color:#fff}.hero{background:var(--cream);min-height:430px;display:grid;place-items:center;text-align:center;padding:65px 20px}.eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}h1,h2,h3{font-family:Georgia,serif;font-weight:400}h1{font-size:clamp(42px,7vw,72px);margin:18px 0}h2{font-size:38px;margin:8px 0 12px}.hero p{color:var(--muted);line-height:1.8;max-width:520px;margin:0 auto 25px}.section{max-width:1200px;margin:auto;padding:65px 22px}.section-head{text-align:center;margin-bottom:30px}.section-head p{color:var(--muted);font-size:14px;line-height:1.7}.collections{display:grid;grid-template-columns:1fr 1fr;gap:18px}.collection{min-height:230px;background:var(--cream);display:flex;flex-direction:column;justify-content:end;padding:30px}.collection:nth-child(2){background:#eee6dc}.collection h3{font-size:29px;margin:8px 0}.collection p{font-size:13px;color:var(--muted)}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:25px 0}.filters{display:flex;gap:8px;flex-wrap:wrap}.filter{border:1px solid var(--line);background:#fff;padding:9px 13px;font-size:11px}.filter.active{background:var(--ink);color:#fff;border-color:var(--ink)}select{border:1px solid var(--line);background:white;padding:10px}.products{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.product-card{border:1px solid var(--line);background:white}.product-image{height:270px;background:var(--cream);display:grid;place-items:center;overflow:hidden}.product-image img{width:100%;height:100%;object-fit:cover}.no-image{font:22px Georgia,serif;color:#a89b8b}.product-info{padding:15px}.product-info h3{font-size:18px;margin:4px 0 8px}.product-info p{font-size:12px;color:var(--muted);line-height:1.6;min-height:34px}.price{font-weight:bold;font-size:14px}.product-actions{display:flex;gap:8px;margin-top:13px}.product-actions button{flex:1}.tag{font-size:9px;color:var(--accent);letter-spacing:.12em;text-transform:uppercase}.empty{grid-column:1/-1;text-align:center;padding:40px;color:var(--muted)}.store{background:var(--cream);text-align:center;padding:55px 22px}.store p{color:var(--muted);line-height:1.8}.map-link{display:inline-block;margin-top:12px;background:var(--ink);color:white;padding:13px 22px;font-size:11px;letter-spacing:.1em}.reviews{max-width:1200px;margin:auto;padding:60px 22px}.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}.review{border:1px solid var(--line);padding:24px}.stars{color:var(--gold);letter-spacing:3px}.review h3{font-size:18px;margin:8px 0 3px}.review small,.review p{color:var(--muted)}.review p{font-size:13px;line-height:1.8}.sample-note{text-align:center;color:var(--muted);font-size:11px;margin-top:20px}.newsletter{background:#eee6dc;text-align:center;padding:45px 20px}.newsletter form{display:flex;max-width:430px;margin:20px auto;gap:8px}.newsletter input{min-width:0;flex:1;padding:12px;border:1px solid var(--line)}footer{background:var(--ink);color:#fff;padding:35px 22px;text-align:center}footer p{color:#d1c7bb;font-size:12px;line-height:1.8}.overlay{display:none;position:fixed;inset:0;background:#0008;z-index:50;align-items:center;justify-content:center;padding:15px}.overlay.open{display:flex}.panel{background:white;width:min(540px,100%);max-height:90vh;overflow:auto;padding:25px;position:relative}.panel h2{font-size:28px}.close{position:absolute;right:15px;top:12px;border:0;background:none;font-size:25px}.field{display:grid;gap:6px;margin:12px 0}.field label{font-size:11px;color:var(--muted)}.field input,.field textarea,.field select{width:100%;padding:12px;border:1px solid var(--line)}.cart-row{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding:12px 0;font-size:13px}.cart-row button{border:0;background:none;color:#a44}.cart-total{display:flex;justify-content:space-between;font-weight:bold;padding:18px 0}.notice{padding:11px;background:var(--cream);font-size:12px;line-height:1.6;margin:12px 0}.status{font-size:12px;color:var(--muted);margin:12px 0}.admin-list{border-top:1px solid var(--line);margin-top:20px}.admin-item{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:12px}.admin-item button{margin-left:5px}.whatsapp{position:fixed;right:17px;bottom:17px;z-index:30;background:#218c54;color:#fff;border-radius:30px;padding:13px 17px;font-size:12px}
@media(max-width:800px){.links{display:none}.products{grid-template-columns:repeat(2,1fr)}.product-image{height:220px}.reviews-grid{grid-template-columns:1fr}.brand{font-size:25px}}
@media(max-width:430px){.products{gap:10px}.product-image{height:185px}.product-info{padding:11px}.product-info h3{font-size:16px}.nav{padding:13px}.outline,.dark{padding:9px}.collections{grid-template-columns:1fr}}
</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
<div class="announcement">COMPLIMENTARY SHIPPING ON ORDERS ABOVE ₹1,499</div>
<header class="header"><nav class="nav">
<a class="brand" href="#home">Rang Rachna</a>
<div class="links"><a href="#home">Home</a><a href="#collections">Collections</a><a href="#shop">Shop all</a><a href="#visit-store">Visit Us</a><a href="#reviews">Reviews</a></div>
<div class="nav-actions"><button class="outline" id="adminBtn">ADMIN</button><button class="dark" id="cartBtn">BAG (<span id="cartCount">0</span>)</button></div>
</nav></header>
<main>
<section class="hero" id="home"><div><div class="eyebrow">Tradition, woven with love</div><h1>Everyday elegance,<br>beautifully Indian.</h1><p>Discover thoughtfully chosen kurtis and suits made for your everyday moments and special occasions.</p><a class="dark" href="#shop">EXPLORE COLLECTION</a></div></section>
<section class="section" id="collections"><div class="section-head"><div class="eyebrow">Explore our world</div><h2>Collections</h2><p>Pieces that make every day feel a little more special.</p></div><div class="collections"><a class="collection" href="#shop" data-collection="Kurtis"><div class="eyebrow">Comfort meets style</div><h3>Everyday Kurtis</h3><p>Easy, graceful styles for every day.</p></a><a class="collection" href="#shop" data-collection="Suits"><div class="eyebrow">Made for moments</div><h3>Elegant Suits</h3><p>Beautiful looks for celebrations and beyond.</p></a></div></section>
<section class="section" id="shop"><div class="section-head"><div class="eyebrow">The Rang Rachna edit</div><h2>Shop Our Collection</h2><p>Find a style that feels like you.</p></div><div class="toolbar"><div class="filters"><button class="filter active" data-filter="All">All</button><button class="filter" data-filter="Kurtis">Kurtis</button><button class="filter" data-filter="Suits">Suits</button></div><select id="sort"><option value="default">Sort: Featured</option><option value="low">Price: Low to High</option><option value="high">Price: High to Low</option></select></div><div id="productGrid" class="products"><div class="empty">Loading collection…</div></div><p class="status" id="productStatus"></p></section>
<section class="store" id="visit-store"><div class="eyebrow">We would love to see you</div><h2>Visit Our Store</h2><p><strong>Rang Rachna – Central Market</strong><br>G-20-21, Mohan Bazar, Phase-I,<br>Ashok Vihar, Delhi – 110052</p><a class="map-link" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=G-20-21+Mohan+Bazar+Phase+I+Ashok+Vihar+Delhi+110052">GET DIRECTIONS ON GOOGLE MAPS</a></section>
<section class="reviews" id="reviews"><div class="section-head"><div class="eyebrow">Kind words</div><h2>Customer Love</h2><p>We look forward to welcoming you to Rang Rachna.</p></div><div class="reviews-grid">
<div class="review"><div class="stars">★★★★★</div><h3>Priya Sharma</h3><small>Delhi</small><p>“Beautiful designs and lovely colours. I really like the traditional collection.”</p></div>
<div class="review"><div class="stars">★★★★★</div><h3>Neha Verma</h3><small>Ashok Vihar</small><p>“The kurtis look elegant and comfortable. Perfect for everyday wear.”</p></div>
<div class="review"><div class="stars">★★★★★</div><h3>Pooja Gupta</h3><small>New Delhi</small><p>“Lovely traditional styles and beautiful patterns. Looking forward to more designs.”</p></div>
</div><p class="sample-note">Sample reviews for demonstration only. Replace these with genuine customer feedback before publishing.</p></section>
<section class="newsletter"><div class="eyebrow">Stay in touch</div><h2>A little note from us</h2><p>Get updates about new arrivals and collections.</p><form id="newsletterForm"><input type="email" id="newsletterEmail" placeholder="Your email address" required><button class="dark">SUBSCRIBE</button></form><p id="newsletterStatus" class="status"></p></section>
</main>
<footer><div class="brand">Rang Rachna</div><p>Central Market, G-20-21 Mohan Bazar, Phase-I, Ashok Vihar, Delhi – 110052<br>Email: hello@rangrachna.com<br>Phone: +91 98765 43210</p><p>© <span id="year"></span> Rang Rachna. All rights reserved.</p></footer>
<a class="whatsapp" href="https://wa.me/919876543210" target="_blank" rel="noopener">WhatsApp Us</a>

<div class="overlay" id="cartOverlay"><div class="panel"><button class="close" data-close="cartOverlay">×</button><h2>Your Bag</h2><div id="cartItems"></div><div class="cart-total"><span>Total</span><span id="cartTotal">₹0</span></div><button class="dark" style="width:100%" id="checkoutBtn">CONTINUE TO CHECKOUT</button><p class="status" id="cartStatus"></p></div></div>
<div class="overlay" id="checkoutOverlay"><div class="panel"><button class="close" data-close="checkoutOverlay">×</button><h2>Checkout</h2><div class="notice">Your order request will be saved to the Rang Rachna order database when the required Supabase permissions are configured.</div><form id="checkoutForm"><div class="field"><label>Full name</label><input id="buyerName" required></div><div class="field"><label>Mobile number</label><input id="buyerPhone" type="tel" required></div><div class="field"><label>Email (optional)</label><input id="buyerEmail" type="email"></div><div class="field"><label>Delivery address</label><textarea id="buyerAddress" rows="3" required></textarea></div><button class="dark" style="width:100%">PLACE ORDER</button></form><p class="status" id="checkoutStatus"></p></div></div>
<div class="overlay" id="adminOverlay"><div class="panel"><button class="close" data-close="adminOverlay">×</button><h2>Rang Rachna Admin</h2><div class="notice">Sign in with a Supabase Auth account that has administrator access. Do not put a secret/service-role key in this website.</div><form id="loginForm"><div class="field"><label>Email</label><input type="email" id="adminEmail" required></div><div class="field"><label>Password</label><input type="password" id="adminPassword" required></div><button class="dark">SIGN IN</button></form><p class="status" id="adminStatus"></p><div id="adminTools" hidden><h3>Add a product</h3><form id="productForm"><div class="field"><label>Product name</label><input id="pName" required></div><div class="field"><label>Description</label><textarea id="pDescription" rows="2"></textarea></div><div class="field"><label>Category</label><select id="pCategory"><option>Kurtis</option><option>Suits</option></select></div><div class="field"><label>Price (₹)</label><input id="pPrice" type="number" min="1" required></div><div class="field"><label>Product image URL (upload image to Supabase Storage first)</label><input id="pImage" type="url" placeholder="https://..."></div><div class="field"><label>Stock</label><input id="pStock" type="number" min="0" value="10"></div><button class="dark">SAVE PRODUCT</button></form><div class="admin-list" id="adminProductList"></div><button class="outline" id="logoutBtn" style="margin-top:18px">SIGN OUT</button></div></div></div>
<script>
/* Add your Supabase Project URL and Publishable key below. Never use a secret/service-role key here. */
const SUPABASE_URL = "https://buitvbrlddmckrpwrcvb.supabase.co/rest/v1/";
const SUPABASE_KEY = "sb_publishable_5y_OzubwqHuyRRClBK00mw_zUDNvQtD";
const supabaseClient = (window.supabase && SUPABASE_URL.startsWith("https://") && !SUPABASE_URL.includes("PASTE_") && !SUPABASE_KEY.includes("PASTE_"))
  ? window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY) : null;

const demoProducts = [
 {id:"demo1",name:"Aaira Block-Print Kurti",description:"A graceful everyday kurti with a traditional block-print look.",category:"Kurtis",price:1299,image_url:"",label:"Bestseller",stock:10},
 {id:"demo2",name:"Zoya Chanderi Suit Set",description:"An elegant suit set for celebrations and special moments.",category:"Suits",price:2899,image_url:"",label:"Elegant",stock:10},
 {id:"demo3",name:"Meera Embroidered Kurti",description:"A beautiful embroidered style for effortless everyday dressing.",category:"Kurtis",price:1599,image_url:"",label:"New",stock:10},
 {id:"demo4",name:"Anarkali Festive Suit",description:"A festive silhouette made for memorable occasions.",category:"Suits",price:3499,image_url:"",label:"Festive",stock:10}
];
let products = [...demoProducts], activeFilter="All", cart=[], currentUser=null;
const $ = id => document.getElementById(id);
const money = n => "₹"+Number(n||0).toLocaleString("en-IN");
function show(id){$(id).classList.add("open")}
function hide(id){$(id).classList.remove("open")}
document.querySelectorAll("[data-close]").forEach(b=>b.addEventListener("click",()=>hide(b.dataset.close)));
document.querySelectorAll(".overlay").forEach(o=>o.addEventListener("click",e=>{if(e.target===o)hide(o.id)}));
$("year").textContent=new Date().getFullYear();

function renderProducts(){
 let list=products.filter(p=>activeFilter==="All" || String(p.category||"").toLowerCase()===activeFilter.toLowerCase());
 const sort=$("sort").value;if(sort==="low")list.sort((a,b)=>a.price-b.price);if(sort==="high")list.sort((a,b)=>b.price-a.price);
 $("productGrid").innerHTML=list.length?list.map(p=>`<article class="product-card"><div class="product-image">${p.image_url?`<img src="${escapeHtml(p.image_url)}" alt="${escapeHtml(p.name)}" loading="lazy">`:`<div class="no-image">Rang Rachna</div>`}</div><div class="product-info"><div class="tag">${escapeHtml(p.label||p.category||"Collection")}</div><h3>${escapeHtml(p.name)}</h3><p>${escapeHtml(p.description||"Beautifully chosen ethnic wear.")}</p><div class="price">${money(p.price)}</div><div class="product-actions"><button class="dark" onclick="addToCart('${String(p.id).replace(/'/g,"")}')">ADD TO BAG</button></div></div></article>`).join(""):'<div class="empty">No products found in this collection yet.</div>';
}
function escapeHtml(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
async function loadProducts(){
 if(!supabaseClient){$("productStatus").textContent="Demo catalogue is showing. Add your Supabase URL and Publishable key in the code to load database products.";renderProducts();return}
 const {data,error}=await supabaseClient.from("products").select("*").eq("is_active",true).order("created_at",{ascending:false});
 if(error){$("productStatus").textContent="Could not load database products: "+error.message+" (Showing demo products for now.)";products=[...demoProducts]}
 else{products=(data||[]).map(p=>({...p,price:Number(p.price||0),image_url:p.image_url||""}));$("productStatus").textContent=products.length?"Showing products from Supabase.":"Your Supabase products table is connected, but it has no active products yet."}
 renderProducts();
}
document.querySelectorAll("[data-filter]").forEach(b=>b.addEventListener("click",()=>{activeFilter=b.dataset.filter;document.querySelectorAll("[data-filter]").forEach(x=>x.classList.toggle("active",x===b));renderProducts()}));
document.querySelectorAll("[data-collection]").forEach(a=>a.addEventListener("click",()=>{activeFilter=a.dataset.collection;document.querySelectorAll("[data-filter]").forEach(x=>x.classList.toggle("active",x.dataset.filter===activeFilter));renderProducts()}));
$("sort").addEventListener("change",renderProducts);
function addToCart(id){const p=products.find(x=>String(x.id)===String(id));if(!p)return;const old=cart.find(x=>String(x.id)===String(id));if(old)old.qty++;else cart.push({...p,qty:1});renderCart()}
function renderCart(){$("cartCount").textContent=cart.reduce((n,p)=>n+p.qty,0);$("cartItems").innerHTML=cart.length?cart.map(p=>`<div class="cart-row"><div><strong>${escapeHtml(p.name)}</strong><br>${money(p.price)} × ${p.qty}</div><div><button onclick="changeQty('${p.id}',-1)">−</button> ${p.qty} <button onclick="changeQty('${p.id}',1)">+</button> <button onclick="removeCart('${p.id}')">Remove</button></div></div>`).join(""):'<p class="status">Your bag is empty.</p>';$("cartTotal").textContent=money(cart.reduce((n,p)=>n+p.price*p.qty,0))}
function changeQty(id,d){const p=cart.find(x=>String(x.id)===String(id));if(!p)return;p.qty+=d;if(p.qty<1)cart=cart.filter(x=>x!==p);renderCart()}
function removeCart(id){cart=cart.filter(x=>String(x.id)!==String(id));renderCart()}
window.addToCart=addToCart;window.changeQty=changeQty;window.removeCart=removeCart;
$("cartBtn").addEventListener("click",()=>{renderCart();show("cartOverlay")});
$("checkoutBtn").addEventListener("click",()=>{if(!cart.length){$("cartStatus").textContent="Your bag is empty.";return}hide("cartOverlay");show("checkoutOverlay")});
$("checkoutForm").addEventListener("submit",async e=>{
 e.preventDefault();$("checkoutStatus").textContent="";
 if(!supabaseClient){$("checkoutStatus").textContent="Supabase is not configured yet. Your order has not been submitted.";return}
 const payload={customer_name:$("buyerName").value.trim(),phone:$("buyerPhone").value.trim(),email:$("buyerEmail").value.trim(),delivery_address:$("buyerAddress").value.trim(),items:cart.map(p=>({product_id:p.id,product_name:p.name,quantity:p.qty,unit_price:p.price})),total_amount:cart.reduce((n,p)=>n+p.price*p.qty,0)};
 $("checkoutStatus").textContent="Order submission needs your database's place_order() function and matching permissions. No order has been placed yet.";
});
$("newsletterForm").addEventListener("submit",e=>{e.preventDefault();$("newsletterStatus").textContent="Thanks! Newsletter signup will be enabled after a subscriptions table is configured."});
$("adminBtn").addEventListener("click",()=>{show("adminOverlay");$("adminStatus").textContent=supabaseClient?"Sign in with your Supabase Auth admin account.":"Add Supabase connection details first."});
$("loginForm").addEventListener("submit",async e=>{e.preventDefault();if(!supabaseClient){$("adminStatus").textContent="Supabase connection details are missing.";return}const {data,error}=await supabaseClient.auth.signInWithPassword({email:$("adminEmail").value,password:$("adminPassword").value});if(error){$("adminStatus").textContent=error.message;return}currentUser=data.user;$("adminStatus").textContent="Signed in. Product management is available only if your Supabase policies permit it.";$("adminTools").hidden=false;renderAdminList()});
$("logoutBtn").addEventListener("click",async()=>{if(supabaseClient)await supabaseClient.auth.signOut();currentUser=null;$("adminTools").hidden=true;$("adminStatus").textContent="Signed out."});
$("productForm").addEventListener("submit",async e=>{e.preventDefault();if(!supabaseClient||!currentUser){$("adminStatus").textContent="Please sign in first.";return}const row={name:$("pName").value.trim(),description:$("pDescription").value.trim(),category:$("pCategory").value,price:Number($("pPrice").value),image_url:$("pImage").value.trim()||null,stock:Number($("pStock").value||0),is_active:true};const {error}=await supabaseClient.from("products").insert(row);if(error){$("adminStatus").textContent="Could not save product: "+error.message;return}$("adminStatus").textContent="Product saved.";e.target.reset();await loadProducts();renderAdminList()});
async function renderAdminList(){if(!supabaseClient||!currentUser)return;const {data,error}=await supabaseClient.from("products").select("id,name,price").order("created_at",{ascending:false});if(error){$("adminProductList").textContent=error.message;return}$("adminProductList").innerHTML=(data||[]).map(p=>`<div class="admin-item"><span>${escapeHtml(p.name)} — ${money(p.price)}</span><button class="text-btn" onclick="deleteProduct('${p.id}')">Delete</button></div>`).join("")||"No products yet."}
async function deleteProduct(id){if(!confirm("Delete this product?"))return;const {error}=await supabaseClient.from("products").delete().eq("id",id);if(error){$("adminStatus").textContent=error.message;return}await loadProducts();renderAdminList()}
window.deleteProduct=deleteProduct;
if(supabaseClient){supabaseClient.auth.getSession().then(({data})=>{if(data.session){currentUser=data.session.user;$("adminTools").hidden=false;renderAdminList()}})}
renderCart();loadProducts();
</script>
</body>
</html>
